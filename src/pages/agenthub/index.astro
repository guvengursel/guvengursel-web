---
import Layout from '../../layouts/Layout.astro';
import { director, teams } from '../../data/agenthub';
---

<Layout title="AgentHub — guvengursel.com" description="The agent team behind guvengursel.com">
  <section class="agenthub">
    <h1>AgentHub</h1>
    <p class="subtitle">The team behind the scenes</p>

    <!-- Director -->
    <div class="director-card">
      <span class="agent-icon">{director.icon}</span>
      <div class="agent-info">
        <h2>{director.name} <small>{director.role}</small></h2>
        <p>{director.description}</p>
        <div class="skills">
          {director.skills.map((s) => <span class="tag">{s}</span>)}
        </div>
      </div>
    </div>

    <!-- Teams -->
    {teams.map((team) => (
      <div class="team">
        <h2><span class="team-icon">{team.icon}</span> {team.name}</h2>
        <div class="team-agents">
          {team.agents.map((agent) => (
            <div class="agent-card">
              <span class="agent-icon">{agent.icon}</span>
              <div class="agent-info">
                <h3>{agent.name} <small>{agent.role}</small></h3>
                <p>{agent.description}</p>
                <div class="skills">
                  {agent.skills.map((s) => <span class="tag">{s}</span>)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .agenthub {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 0;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.5rem;
    color: var(--heading);
    margin-bottom: 0.25rem;
  }

  .subtitle {
    color: var(--pitch);
    margin-bottom: 3rem;
    font-size: 0.95rem;
  }

  /* Director */
  .director-card {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 3rem;
    background: var(--toggle-bg);
  }

  .director-card .agent-icon {
    font-size: 2rem;
    flex-shrink: 0;
    line-height: 1;
    color: var(--accent);
  }

  .director-card h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.5rem;
    color: var(--heading);
    margin: 0 0 0.5rem;
  }

  .director-card h2 small {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--pitch);
    font-weight: 400;
    margin-left: 0.5rem;
  }

  .director-card p {
    color: var(--body);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  /* Teams */
  .team {
    margin-bottom: 3rem;
  }

  .team h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.25rem;
    color: var(--heading);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .team-icon {
    color: var(--accent);
  }

  .team-agents {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* Agent cards */
  .agent-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .agent-card .agent-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1;
    color: var(--accent);
    align-self: flex-start;
  }

  .agent-card h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.1rem;
    color: var(--heading);
    margin: 0 0 0.25rem;
  }

  .agent-card h3 small {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--pitch);
    font-weight: 400;
    margin-left: 0.35rem;
  }

  .agent-card p {
    color: var(--body);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }

  /* Tags */
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .director-card {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }

    .team-agents {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 2rem;
    }
  }
</style>
