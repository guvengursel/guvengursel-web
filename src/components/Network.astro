---
// Build-time generative neural field: layered nodes and edges across the
// full stage. Each element carries:
//   --d  forward-pass delay (sampling wave choreography, pure CSS)
//   --p  activation threshold; an element is in the nucleus when the
//        joint sampler passes it: eff = temp * top-p (CSS calc)
//   --o  base opacity
// Coherence rules baked at build time:
//   - An edge's threshold is the max of its endpoint nodes' thresholds,
//     so a visible edge never flows to a hidden node.
//   - One "argmax" node per layer forms the greedy spine (--p: -1):
//     at temperature 0 only that decoding path remains lit.
// The topology prop selects between pre-rendered variants so "reseed"
// can swap graphs client-side with zero runtime generation.

interface Props {
  seed: number;
  topology: number;
  class?: string;
}

const { seed, topology, class: className } = Astro.props;

function mulberry32(s: number) {
  let a = s >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);

const W = 800;
const H = 600;

const layerSizes = [4, 7, 8, 7, 5, 3];
const x0 = 30;
const x1 = 775;
const widest = Math.max(...layerSizes);

const nodes: {
  x: number; y: number; layer: number; r: number;
  p: number; greedy: boolean;
}[] = [];

layerSizes.forEach((count, li) => {
  const x = x0 + (x1 - x0) * (li / (layerSizes.length - 1));
  const argmax = Math.floor(rand() * count);
  for (let i = 0; i < count; i++) {
    const y =
      300 +
      ((i - (count - 1) / 2) * (H * 0.74)) / widest +
      (rand() - 0.5) * 26;
    const greedy = i === argmax;
    nodes.push({
      x: x + (rand() - 0.5) * 18,
      y,
      layer: li,
      r: greedy ? 3.6 + rand() * 1.2 : 2.2 + rand() * 1.6,
      p: rand(),
      greedy,
    });
  }
});

// One forward-pass stage per layer gap; each edge carries its wave
// delay plus a seeded jitter so the pulse reads organic, not mechanical.
const STAGE_S = 0.3;
const edges: {
  x1: number; y1: number; x2: number; y2: number;
  d: string; p: string; o: string; stage: number; greedy: boolean;
}[] = [];
for (let li = 0; li < layerSizes.length - 1; li++) {
  const from = nodes.filter((n) => n.layer === li);
  const to = nodes.filter((n) => n.layer === li + 1);
  for (const a of from) {
    for (const b of to) {
      if (rand() < 0.22) continue; // prune for air
      const greedy = a.greedy && b.greedy;
      edges.push({
        x1: a.x,
        y1: a.y,
        x2: b.x,
        y2: b.y,
        d: (li * STAGE_S + rand() * 0.08).toFixed(2),
        p: greedy ? '-1' : Math.max(a.p, b.p).toFixed(2),
        o: greedy ? '0.6' : (0.08 + rand() * 0.1).toFixed(2),
        stage: li,
        greedy,
      });
    }
  }
}
---

<svg
  class={className}
  data-topology={topology}
  viewBox={`0 0 ${W} ${H}`}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
>
  <g class="net-edges">
    {edges.map((e) => (
      <line
        x1={e.x1.toFixed(1)}
        y1={e.y1.toFixed(1)}
        x2={e.x2.toFixed(1)}
        y2={e.y2.toFixed(1)}
        class={`net-edge net-s${e.stage}${e.greedy ? ' net-greedy' : ''}`}
        style={`--d: ${e.d}s; --p: ${e.p}; --o: ${e.o};`}
      />
    ))}
  </g>
  {nodes.map((n) => (
    <circle
      cx={n.x.toFixed(1)}
      cy={n.y.toFixed(1)}
      r={n.r.toFixed(1)}
      class={`net-node net-l${n.layer}${n.greedy ? ' net-greedy' : ''}`}
      style={`--d: ${(n.layer * STAGE_S).toFixed(2)}s; --p: ${n.greedy ? '-1' : n.p.toFixed(2)};`}
    />
  ))}
</svg>
