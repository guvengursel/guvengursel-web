---
// Compact slice of the neural identity: a shallow, seeded field strip
// used as a section divider so every route carries a fragment of the
// home stage. Deterministic per seed; rendered at build time.

interface Props {
  seed: number;
  class?: string;
}

const { seed, class: className } = Astro.props;

function mulberry32(s: number) {
  let a = s >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);

const W = 800;
const H = 140;
const layerSizes = [5, 8, 5];
const widest = Math.max(...layerSizes);
const x0 = 20;
const x1 = 780;

const nodes: { x: number; y: number }[] = [];
layerSizes.forEach((count, li) => {
  const x = x0 + (x1 - x0) * (li / (layerSizes.length - 1));
  for (let i = 0; i < count; i++) {
    nodes.push({
      x: x + (rand() - 0.5) * 20,
      y: H / 2 + ((i - (count - 1) / 2) * (H * 0.7)) / widest + (rand() - 0.5) * 10,
    });
  }
});

const edges: { a: { x: number; y: number }; b: { x: number; y: number } }[] = [];
const bounds = layerSizes.reduce<number[]>((acc, n) => [...acc, acc.length + n], []);
for (let li = 0; li < layerSizes.length - 1; li++) {
  const from = nodes.slice(bounds[li - 1] ?? 0, bounds[li]);
  const to = nodes.slice(bounds[li], bounds[li + 1]);
  for (const a of from) {
    for (const b of to) {
      if (rand() < 0.3) continue;
      edges.push({ a, b });
    }
  }
}
---

<svg class={className} viewBox={`0 0 ${W} ${H}`} fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  {edges.map((e) => (
    <line x1={e.a.x.toFixed(1)} y1={e.a.y.toFixed(1)} x2={e.b.x.toFixed(1)} y2={e.b.y.toFixed(1)} stroke="currentColor" stroke-width="1" opacity={(0.1 + rand() * 0.1).toFixed(2)} />
  ))}
  {nodes.map((n) => (
    <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={(2 + rand() * 1.5).toFixed(1)} fill="currentColor" opacity="0.5" />
  ))}
</svg>
